# profile-app server settings. All have dev defaults; copy to `.env` to override.
# `node server/index.ts` does not read `.env` by itself: export these in your shell
# or run `node --env-file=.env server/index.ts`.

# Signing key for login tokens. Use a long random value outside local development.
JWT_SECRET=dev-only-secret
# SQLite database file.
DB_PATH=profile-app.sqlite
# API port.
PORT=4000
